{
  "name": "anvil-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Anvil, the admin bot for the AnvilCAD Discord server",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
