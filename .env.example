# Copy to .env for running Anvil on your own machine (npm start). .env is git-ignored.
# Never commit a real token, and never paste it into an issue, chat or log.

# Either point at a file that holds only the token (preferred)...
DISCORD_TOKEN_FILE=./secrets/discord_token
# ...or set the token itself (only for quick local tests).
# DISCORD_TOKEN=

# The one server Anvil works in. It leaves any other server it is added to.
GUILD_ID=

# Where Anvil keeps its journal (for /undo), its state and its log file.
DATA_DIR=./data

# Optional: pin the admin role and log channel by ID. When unset, Anvil creates
# an "Anvil Admin" role and a private #anvil-log channel on first start and
# remembers their IDs in DATA_DIR/state.json.
# ADMIN_ROLE_ID=
# LOG_CHANNEL_ID=
